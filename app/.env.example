# Public values only: EXPO_PUBLIC_* values are readable in the app bundle.
EXPO_PUBLIC_APP_ENV=development
# USB: adb reverse tcp:5000 tcp:5000
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000/api
# LAN: http://<PC-LAN-IP>:5000/api
# Remote development: https://<development-api-host>/api
# Production placeholder: https://<production-api-host>/api

# Cloudinary, for receipt and payment-proof images.
# Same unsigned preset the web client uses. An unsigned preset is public by design:
# it permits upload only, never read, overwrite or delete. The API secret is NOT here
# and must never be -- everything EXPO_PUBLIC_* ships inside the APK.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>
EXPO_PUBLIC_CLOUDINARY_FOLDER=splitwise

# Google AdMob. Configuration, not secrets: every one of these ships inside the APK.
# Left blank, the app uses Google’s official TEST ad units and sample app ids.
# Never point a development build at a live unit -- that is invalid traffic.
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADS_INTERSTITIALS_ENABLED=false

# Fill these in only for a production build.
EXPO_PUBLIC_ANDROID_ADMOB_APP_ID=
EXPO_PUBLIC_ANDROID_BANNER_AD_UNIT_ID=
EXPO_PUBLIC_ANDROID_INTERSTITIAL_AD_UNIT_ID=
EXPO_PUBLIC_IOS_ADMOB_APP_ID=
EXPO_PUBLIC_IOS_BANNER_AD_UNIT_ID=
EXPO_PUBLIC_IOS_INTERSTITIAL_AD_UNIT_ID=
