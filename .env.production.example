# SplitMoney production environment.
#
# Copy this to `.env` on the EC2 instance, fill it in, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Docker Compose reads a file named exactly `.env` from the directory you run the
# command in. This file is never committed and never enters the image.
#
# Generate every secret below with:
#   openssl rand -base64 32


# ---- Where the app lives ---------------------------------------------------
# A domain that already points at this instance's public IP. Caddy requests a
# certificate for exactly this name, so it must resolve before you start the
# stack. No https:// prefix, no trailing slash.
DOMAIN=splitmoney.example.com


# ---- Database --------------------------------------------------------------
# Postgres runs in a container beside the app. This password is only used
# between the two containers, but generate a real one anyway: the database
# volume outlives the containers, and a weak password becomes permanent.
POSTGRES_USER=splitmoney
POSTGRES_PASSWORD=
POSTGRES_DB=splitmoney


# ---- Secrets ---------------------------------------------------------------
# The server refuses to start without these. Minimum 16 characters each.
JWT_SECRET=
OTP_HASH_SECRET=


# ---- First administrator ---------------------------------------------------
# Used once, by `npm run db:seed:admin`. The seed refuses to run in production
# without an explicit password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# ---- Email (Resend) --------------------------------------------------------
# Optional. Without it, signup and password-reset codes are logged rather than
# delivered, which is fine for a trial run and not for real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SplitMoney <onboarding@resend.dev>


# ---- Image uploads (Cloudinary) --------------------------------------------
# The two VITE_ values are compiled into the JavaScript bundle and are public by
# design. The API key and secret are not, and stay on the server.
#
# The upload preset must exist in Cloudinary and be marked UNSIGNED, or every
# upload fails with "Upload preset not found".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=splitmoney
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---- Web push --------------------------------------------------------------
# Optional. Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is compiled into the frontend; the private key never leaves the
# server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com


# ---- Legacy data migration (one-off) ---------------------------------------
# Only needed if you are importing an existing group out of the old MongoDB
# database. Leave blank otherwise -- the app does not use it.
#
# Read-only: the migration copies data out and never writes to the source.
SOURCE_MONGODB_URI=

# The migration refuses to write to a production database unless this is set to
# 1, so that doing so is always deliberate. Set it only while migrating, then
# remove it again.
ALLOW_PRODUCTION_MIGRATION=


# ---- Optional --------------------------------------------------------------
VITE_APP_NAME=SplitMoney
GEMINI_API_KEY=
