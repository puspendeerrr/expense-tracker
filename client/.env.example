# ---------------------------------------------------------------------------
# Frontend environment
#
# ONLY non-secret, publishable values belong here. Everything prefixed with
# VITE_ is inlined into the JavaScript bundle and is therefore public. Never put
# an API secret, a database URL, or the Resend key in this file.
# ---------------------------------------------------------------------------

# Base URL of the API. Leave blank in development to use the Vite proxy, which
# keeps the app same-origin so the session cookie is sent normally.
VITE_API_BASE_URL=

# Socket.IO endpoint. Blank means "same origin as the page", which is what the
# dev proxy and a single-origin production deploy both want.
VITE_SOCKET_URL=

# Product identity, used in titles and headings.
VITE_APP_NAME=SplitMoney

# ---- Cloudinary (unsigned uploads) ----------------------------------------
# The browser uploads receipts and payment QR images straight to Cloudinary using
# an UNSIGNED upload preset, so no API secret is needed on the client. Create the
# preset in Cloudinary as "unsigned" and restrict it to the folder below.
# The API secret stays server-side in server/.env and is never exposed here.
VITE_CLOUDINARY_CLOUD_NAME=demo-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=splitmoney_unsigned
VITE_CLOUDINARY_FOLDER=splitmoney

# Largest image accepted before client-side compression kicks in (bytes).
VITE_MAX_UPLOAD_BYTES=5242880

# ---- Web push --------------------------------------------------------------
# VAPID *public* key. Public by design: it identifies the server to the push
# service. The matching private key lives only in server/.env.
VITE_VAPID_PUBLIC_KEY=
