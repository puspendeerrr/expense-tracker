# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Allowed CORS client origins (comma-separated)
CLIENT_ORIGINS=http://localhost:5173

# PostgreSQL Database Connection (Docker mapped to port 5434)
DATABASE_URL=postgres://splitwise:splitwise@localhost:5434/splitwise
# Dedicated test database. The suite TRUNCATES every table, so this must never
# point at the database above. Create it with: npm run db:test:setup
TEST_DATABASE_URL=postgres://splitwise:splitwise@localhost:5434/splitwise_test

# Resend Transactional Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=SplitWise <onboarding@resend.dev>

# Cryptographic Secrets (minimum 16 characters)
JWT_SECRET=splitwise_jwt_dev_secret_at_least_16_chars
OTP_HASH_SECRET=splitwise_otp_pepper_secret_at_least_16_chars

# OTP Expiry and Cooldown Rules
OTP_EXPIRES_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Session & Token Lifespans
SESSION_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=600

# Cookie Configuration (optional in development)
# COOKIE_DOMAIN=

# ---- Cloudinary (media storage) -------------------------------------------
# The browser uploads directly to Cloudinary with an UNSIGNED preset, so the
# secret below is only needed for server-side deletion of orphaned assets.
# Leave blank to disable media features entirely.
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=replace_me_with_your_cloudinary_secret
CLOUDINARY_UPLOAD_PRESET=splitwise_unsigned
CLOUDINARY_FOLDER=splitwise

# ---- Web push (VAPID) ------------------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# The PUBLIC key is also placed in client/.env as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Legacy migration (read-only) -----------------------------------------
# Connection string for the old expense-tracker MongoDB Atlas database.
# The migration tool ONLY reads from it; every write method is blocked at runtime.
# Used by: npm run migrate:group -- --code IOWUVL --dry-run
SOURCE_MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/fixoradatabase

# ---- Gemini AI Assistant --------------------------------------------------
# API key from Google AI Studio (https://aistudio.google.com).
# Server-side only. NEVER expose this or prefix with VITE_.
GEMINI_API_KEY=
