{
  "name": "splitwise-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SplitWise authentication API",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run db:migrate && tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed:admin": "tsx src/db/seedAdmin.ts",
    "test": "tsx src/db/setupTestDb.ts && vitest run",
    "db:seed:qa": "tsx src/db/seedQa.ts",
    "db:test:setup": "tsx src/db/setupTestDb.ts",
    "migrate:group": "tsx src/migration/run.ts",
    "start:compiled": "node dist/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "mongodb": "^7.6.0",
    "pg": "^8.16.3",
    "resend": "^6.1.2",
    "socket.io": "^4.8.3",
    "tsx": "^4.20.6",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
